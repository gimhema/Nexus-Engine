// 표시 데이터 — 클라이언트 쪽 절반. 수치는 rules.ron 에 두고 여기에는 넣지 않는다.
//
// 번호는 rules.ron 의 아이템 번호와 같다. 색은 sRGB (땅에 떨어졌을 때의 마름모 색).
(
    version: 1,

    // 액터 타입의 표시 이름과 스프라이트 시트. 번호는 rules.ron 의 actors 와 같다.
    //
    // sheet 를 생략하거나 읽지 못하면 내장 플레이스홀더를 쓴다. 경로는 작업 디렉터리
    // (WorldEditor/) 기준. 시트 교체는 **에디터를 다시 시작**해야 반영된다
    // (그림은 시작할 때 GPU 에 한 번 올린다).
    actors: {
        1: (
            name: "플레이어",
            // WorldCanvas 원본: WorldCanvas/sprites/player.canvas
            sheet: "assets/worldcanvas/player.sheet.ron",
        ),
        10: (
            name: "마을 사람",
            sheet: "assets/third_party/zelda-like-armm1998/npc.sheet.ron",
        ),
        100: (
            name: "슬라임",
            sheet: "assets/third_party/slime-garakh/monster.sheet.ron",
        ),
        101: (
            name: "늪 슬라임",
            sheet: "assets/third_party/slime-garakh/monster.sheet.ron",
            // 시트를 공유하되 색만 달리한다 (명시한 색은 컬러 시트에도 곱해진다).
            //
            // ⚠ 곱하기라 **어둡게·탁하게만** 된다 — 초록 그림에 빨강을 곱해도 빨개지지 않고
            // 짙은 올리브색이 된다 (빨강 성분이 원래 적어서). 색을 완전히 바꾸려면 그 색의
            // 그림이 따로 있어야 한다 (이 팩에는 주황·보라 변종이 있다 — SOURCE.md 참고).
            tint: (1.0, 0.45, 0.45),
        ),
        102: (
            name: "고블린",
            // WorldCanvas 원본: WorldCanvas/sprites/goblin.canvas
            sheet: "assets/worldcanvas/goblin.sheet.ron",
        ),
        103: (
            name: "테스트액터",
        ),
    },

    items: {
        501: (name: "빨간 포션", color: (0.95, 0.30, 0.30)),
        502: (name: "파란 포션", color: (0.35, 0.50, 0.95)),
        909: (name: "젤리", color: (0.55, 0.85, 0.95)),
        1101: (name: "숏소드", color: (0.95, 0.85, 0.40)),
        2101: (name: "모자", color: (0.95, 0.85, 0.40)),
    },

    // 스킬의 표시 이름 (P10). 번호는 rules.ron 의 skills 와 같다. 이름이 없으면 "스킬 #번호" 로 보인다.
    skills: {
        1: (name: "베기"),
        2: (name: "물기"),
        3: (name: "일격"),
        4: (name: "강타"),
        5: (name: "강베기"),
        6: (name: "돌 던지기"),
        7: (name: "회오리 베기"),
        8: (name: "치유"),
    },

    // 진영의 표시 이름. 번호는 rules.ron 의 진영 번호(서버 EFactionId 번호 공간)와 같다.
    // 이름이 없으면 번호만 보인다. 게임 규칙 설정 창에서 고친다 (이 블록 안의 주석은 저장할 때 사라진다).
    factions: {
        1: (name: "플레이어"),
        100: (name: "마을"),
        201: (name: "야생 몬스터"),
    },

    // 직업의 이름·설명 (R2). 번호는 rules.ron 의 classes 와 같다.
    classes: {
        1: (name: "전사", description: "힘과 체력으로 버틴다. 칼을 든다."),
        2: (name: "마법사", description: "지능이 높아 MP 가 많고 빨리 찬다. 칼은 들 수 없다."),
        3: (name: "궁수", description: "민첩이 공격력이 된다."),
    },

    // 기본 스탯의 화면 이름 (R2). 키는 rules.ron 의 stats.base. 없으면 규칙 이름 그대로 보인다.
    stats: {
        "str": (name: "힘"),
        "vit": (name: "체력"),
        "int": (name: "지능"),
        "agi": (name: "민첩"),
    },
)
