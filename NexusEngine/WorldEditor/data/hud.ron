// 플레이 화면 HUD — 폰트·창 그림과 위젯 배치. **클라이언트만 보는 데이터다.**
// 에디터의 HUD 편집기(메뉴 플레이 → HUD 편집기)가 이 파일을 고치고 저장한다.
//
// pos·size 는 HUD 픽셀(scale 을 곱하기 전)이고, anchor 모서리에서 오른쪽·아래가 +다.
// 글자 문구에 쓸 수 있는 값: {hp} {max_hp} {level} {exp} {exp_to_next}
// ⚠ 이 폰트에는 한글도 '/' 도 없다 — HUD 문구는 영문 대문자·숫자만.
(
    version: 1,

    font: (
        image: "assets/third_party/zelda-like-armm1998/gfx/font.png",
        // 글자 하나가 차지하는 가로 폭과 줄 높이 (픽셀).
        advance: 8,
        line_height: 16,
        // 받아온 폰트는 균일 격자가 아니다 — 알파벳은 8×16 칸, 숫자는 8×8 로 오른쪽 구석에 있다.
        // 그래서 칸 크기를 구간마다 따로 적는다. (x, y) 는 첫 글자의 왼쪽 위 픽셀이다.
        runs: [
            (chars: "AaBbCcDdEeFfGgHhIiJjKkLlMm", x: 0, y: 0, size: (8, 16)),
            (chars: "NnOoPpQqRrSsTtUuVvWwXxYyZz", x: 0, y: 16, size: (8, 16)),
            (chars: ".,!¡?¿#_-▼:;'\"", x: 0, y: 32, size: (8, 16)),
            (chars: "012", x: 216, y: 0, size: (8, 8)),
            (chars: "345", x: 216, y: 8, size: (8, 8)),
            (chars: "678", x: 216, y: 16, size: (8, 8)),
            (chars: "9", x: 224, y: 24, size: (8, 8)),
        ],
    ),

    // 인벤토리 창의 배경 — 같은 그림 아래쪽에 있는 말풍선 상자를 9-slice 로 쓴다.
    // border 는 늘어나지 않는 가장자리 두께 (픽셀).
    panel: (x: 0, y: 48, width: 232, height: 88, border: 12),

    // HUD 확대 배율. **정수여야** 픽셀이 뭉개지지 않는다.
    scale: 2,

    // 위젯 — 목록 순서대로 그린다 (뒤가 위). 편집기에서 끌어 옮기고 저장하면 여기가 바뀐다.
    // ⚠ 저장하면 이 블록은 다시 쓰인다 — 블록 **안**의 주석은 남지 않는다 (바깥 주석은 그대로다).
    // items 위젯은 플레이 중 I 로 열고 닫는다.
    widgets: [
        (
            id: "hp_text",
            anchor: BottomLeft,
            pos: (12, -46),
            kind: Text(format: "HP {hp}"),
        ),
        (
            id: "hp_bar",
            anchor: BottomLeft,
            pos: (12, -26),
            kind: Bar(source: Hp, size: (110, 9), color: (0.85, 0.25, 0.25)),
        ),
        (
            id: "exp_bar",
            anchor: BottomLeft,
            pos: (12, -12),
            kind: Bar(source: Exp, size: (110, 5), color: (0.35, 0.75, 0.95)),
        ),
        (
            id: "level_text",
            anchor: BottomLeft,
            pos: (134, -14),
            kind: Text(format: "LV {level}  EXP {exp}"),
        ),
        (
            id: "items",
            anchor: TopRight,
            pos: (-12, 12),
            kind: Items(columns: 6),
        ),
    ],
)
