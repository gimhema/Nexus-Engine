// 게임 규칙 수치 — 서버 테이블과 짝을 이루는 절반. 이름·색·에셋 경로는 display.ron 에.
//
// 번호(스킬·아이템·드롭 테이블·진영)는 서버와 같은 ID 공간이다 — ID 공간이 곧 프로토콜.
// 단위: 거리 m, 속도 m/s, 시간 ms, 확률 천분율(1000 = 반드시).
// 이 파일을 고치면 다음 플레이 시작(F5)부터 적용된다 — 다시 빌드할 필요 없다.
(
    version: 1,
    // 드롭 난수 시드. 같은 시드·같은 입력이면 같은 드롭이 나온다.
    seed: 1,

    // 진영 관계 (대칭). 적지 않은 쌍은 중립, 같은 진영은 우호.
    // 1 = 플레이어, 100 = 마을, 201 = 야생 몬스터 (서버 EFactionId 와 같은 번호 공간)
    relations: [
        (a: 1, b: 201, relation: Hostile),
    ],

    // 스킬 — 서버 SkillDef 의 단일 대상 부분.
    // mp_cost 는 적지 않으면 0 — MP 를 보지 않는다. MP 가 모자라면 거절되고 쿨타임도 걸리지 않는다.
    //
    // 스킬 레벨 (R3): max_level 을 주면 레벨이 생기고, cooldown_ms·mp_cost·heal 은 숫자 대신 **수식**,
    // power 는 위력 천분율 수식(적으면 damage_mult 대신 쓴다)이다. 변수: 기본 스탯 · level ·
    // equip_attack · equip_defense · skill_level. classes 는 배울 수 있는 직업(비우면 누구나),
    // requires 는 습득 조건(트리거의 when 과 같은 형식). 직업이 있는 유닛(플레이어)은 배운 스킬과
    // 기본 공격만 쓴다 — 배우는 길은 직업의 시작 스킬 · 스킬북 아이템 · 트리거 GrantSkill.
    skills: {
        1: (range: 2.0, cooldown_ms: 800, damage_mult: 1.0),   // 플레이어 베기
        2: (range: 1.5, cooldown_ms: 1200, damage_mult: 1.0),  // 슬라임 물기
        3: (range: 2.0, cooldown_ms: 1000, damage_mult: 1.2),  // 경비병 일격
        4: (range: 2.0, cooldown_ms: 3000, damage_mult: 2.0, mp_cost: 20),  // 고블린 강타
        // 강베기 — 레벨 1 은 예전과 같은 1.8배·MP 15.
        5: (range: 2.0, cooldown_ms: 3000, power: "1700 + skill_level * 100", mp_cost: "13 + skill_level * 2", max_level: 5, classes: [1, 3]),
        6: (range: 6.0, cooldown_ms: 2000, damage_mult: 0.8, mp_cost: 10),  // 플레이어 돌 던지기 (단축키 2)
        7: (range: 2.0, cooldown_ms: 4000, damage_mult: 1.2, mp_cost: 20, radius: 2.5),  // 플레이어 회오리 베기 (단축키 3) — 대상 둘레 2.5m 의 적 모두
        // 치유 — 자신. 지능에 비례한다 (전사 레벨 1 은 예전과 같은 60).
        8: (range: 0.0, cooldown_ms: 6000, damage_mult: 0.0, mp_cost: 15, heal: "40 + int * 2 + skill_level * 10", max_level: 5),
        // 화염구 — 마법사 전용, 레벨 3 부터. 트리거 3(레벨 3 도달)이 주고, 마도서(3002)로도 배운다.
        9: (
            range: 6.0,
            cooldown_ms: "3000 - skill_level * 200",
            power: "1400 + skill_level * 200 + int * 20",
            mp_cost: "8 + skill_level * 4",
            max_level: 5,
            classes: [2],
            requires: Level(cmp: Ge, value: 3),
        ),
    },

    items: {
        // value 는 기본 값(기본 재화) — 상점이 사들일 때의 기준 (R4). 적지 않으면 팔 수 없다.
        501: Consumable(heal: 60, max_stack: 20, value: 40),   // 빨간 포션
        502: Consumable(heal: 0, mana: 40, max_stack: 20, value: 50),   // 파란 포션
        909: Consumable(heal: 15, max_stack: 99, value: 6),   // 젤리
        // 장비는 기본 스탯 보너스(stats)와 입을 수 있는 직업(classes, 비우면 누구나)을 가질 수 있다 (R2).
        1101: Equipment(slot: Weapon, attack: 12, defense: 0, classes: [1, 3], value: 200),  // 숏소드 — 마법사는 못 든다
        2101: Equipment(slot: Head, attack: 0, defense: 4, value: 120),     // 모자
        // 스킬북 (R3) — 쓰면 그 스킬을 배운다 / 한 레벨 올린다. 드롭 표·상점에 실으면 그것이 습득 경로다.
        3001: SkillBook(skill: 5, max_stack: 5, value: 300),   // 강베기 비급
        3002: SkillBook(skill: 9, max_stack: 5, value: 800),   // 화염구 마도서 — 상점 1 이 판다
    },

    // 드롭 테이블 — 줄마다 따로 굴린다.
    loot: {
        1: [
            (item: 909, count: 1, chance_per_mille: 800),
            (item: 501, count: 1, chance_per_mille: 250),
            (item: 2101, count: 1, chance_per_mille: 150),
        ],
    },

    // 액터 타입별 수치. 마커가 이 번호를 가리킨다 (이름·스프라이트는 display.ron).
    //
    // 번호는 서버 테이블과 같은 ID 공간이다. 지금 쓰는 구간:
    //   1~9    플레이어블
    //   10~99  NPC
    //   100~   몬스터
    actors: {
        1: (
            move_speed: 4.0,
            max_hp: 200,
            // MP 는 초당 mp_regen 씩 차오른다. 적지 않으면 0 — MP 가 없는 액터.
            max_mp: 60,
            mp_regen: 2,
            attack: 20,
            defense: 5,
            faction: 1,
            basic_attack: Some(1),
            // 단축키 스킬 — 조작할 때 숫자키 1·2·… 로 쓴다 (맨 앞이 1번 키).
            skills: [5, 6, 7, 8],
            // 레벨이 오를 때마다 더해지는 수치 (P3). 필요 경험치는 level² × 100.
            growth: (max_hp: 40, max_mp: 10, attack: 4, defense: 2),
        ),
        // 서버 NpcEntityData 기본값처럼 불사·방어형.
        10: (
            move_speed: 1.5,
            max_hp: 300,
            attack: 25,
            defense: 10,
            immortal: true,
            faction: 100,
            ai: Defensive,
            aggro_range: 6.0,
            leash_range: 10.0,
            basic_attack: Some(3),
        ),
        // 상인 (R4) — 기능(services)이 붙으면 클릭했을 때 치지 않고 말을 건다.
        // NPC 역할은 종류가 아니라 기능의 조합이다: Shop(상점 번호) · Heal(price: 기본 재화).
        11: (
            move_speed: 1.5,
            max_hp: 300,
            attack: 25,
            defense: 10,
            immortal: true,
            faction: 100,
            services: [Shop(1), Heal(price: 20), Teleport(2), Quest(1)],
        ),
        // 대장장이 (R4-2) — 제작 · 창고 · 마을 안 텔레포트.
        12: (
            move_speed: 1.5,
            max_hp: 300,
            attack: 25,
            defense: 10,
            immortal: true,
            faction: 100,
            services: [Craft(1), Storage, Teleport(1), Quest(2)],
        ),
        // 서버 MonsterEntityData 기본값처럼 공격형.
        100: (
            move_speed: 2.0,
            max_hp: 80,
            attack: 18,
            defense: 2,
            faction: 201,
            ai: Aggressive,
            aggro_range: 6.0,
            leash_range: 14.0,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 60,
            // 죽은 뒤 10초면 스폰 지점에 다시 나타난다. 적지 않으면 시체로 남는다 (플레이어·NPC).
            respawn_ms: 10000,
            // 쓰러뜨린 쪽이 받는 재화 (R4, 기본 재화).
            bounty: 15,
        ),
        // 같은 몬스터 마커라도 타입이 다르면 수치가 다르다 — 액터 타입의 요점.
        101: (
            move_speed: 2.6,
            max_hp: 140,
            attack: 26,
            defense: 6,
            faction: 201,
            ai: Aggressive,
            aggro_range: 9.0,
            leash_range: 18.0,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 140,
            respawn_ms: 15000,
            bounty: 30,
        ),
        // 스크립트로 움직이는 액터 (P2). AI 는 Passive — 누구를 언제 칠지는 스크립트가 정한다.
        // script 는 data/ 기준 경로. 스크립트를 고치고 F5 만 다시 누르면 적용된다.
        102: (
            move_speed: 3.2,
            max_hp: 90,
            max_mp: 30,
            mp_regen: 3,
            attack: 16,
            defense: 3,
            faction: 201,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 90,
            respawn_ms: 12000,
            bounty: 20,
            script: Some("scripts/goblin.rhai"),
        ),
        103: (
            move_speed: 2.0,
            max_hp: 50,
            attack: 5,
            defense: 0,
        ),
    },

    // 마커 종류별 기본 액터 — 마커가 타입을 정하지 않았을 때(예전 존 파일 포함) 쓴다.
    default_actors: {
        Player: 1,
        Npc: 10,
        Monster: 100,
    },

    // 플레이어가 클릭으로 공격할 때 쓰는 스킬.
    player_attack: 1,
    // 플레이어 시작 소지품.
    starting_kit: [
        (item: 501, count: 3),
        (item: 502, count: 2),
        (item: 1101, count: 1),
    ],
    // 플레이어 기본 부활 — 쓰러지면 delay_ms 뒤 저장 지점(처음 선 자리, 이어 하기면 저장한 자리)에서
    // 최대치의 hp_percent 로 일어나고, 지금 레벨의 경험치를 exp_loss_percent 만큼 잃는다.
    // 일어난 뒤 protect_ms 동안은 공격받지 않는다 (몬스터도 노리지 않는다).
    // 액터 스크립트에 on_dead 를 정의하면 그 액터는 이 규칙 대신 스크립트가 부활시킨다 (revive 함수).
    revive: (delay_ms: 3000, hp_percent: 100, exp_loss_percent: 0, protect_ms: 3000),
    // 땅에 떨어진 아이템(드롭·버린 것)이 사라지기까지 ms. 0 이면 영영 남는다.
    ground_item_ms: 60000,

    // 스탯 체계 (R2) — 기본 스탯의 이름·개수와 파생 스탯 수식을 여기서 정한다.
    // 수식은 정수 연산이다: + - * / %, 괄호, min(a, b) · max(a, b) · clamp(x, lo, hi).
    // 나눗셈은 0 쪽으로 버리고(1.5배는 x * 3 / 2), 0 으로 나누면 0. 결과가 음수면 0, 최대 HP 는 1 이상.
    // 수식이 읽을 수 있는 이름: 아래 base 의 스탯 + level · equip_attack · equip_defense (장비 합계).
    // 직업이 있는 유닛(플레이어)만 이 수식을 쓴다 — 몬스터·NPC 는 actors 의 수치 그대로다.
    stats: (
        base: ["str", "vit", "int", "agi"],
        derived: (
            max_hp: "vit * 20 + level * 20",
            max_mp: "int * 10 + 10",
            mp_regen: "int / 2",
            attack: "str * 2 + equip_attack",
            defense: "agi + equip_defense",
        ),
    ),
    // 재화 (R4) — 아이템과 별개인 지갑. 번호는 서버와 같은 ID 공간, 이름은 display.ron 의 currencies.
    // default_currency 는 값만 적은 곳(아이템 value · 상점 price · bounty · starting_currency)의 재화다.
    currencies: [1],
    default_currency: 1,
    starting_currency: 100,
    // 상점 (R4) — goods 의 순서가 물건 번호다. price 는 기본 재화(다른 재화면 currency: N).
    // buy_rate 는 플레이어가 파는 물건을 사들이는 비율(아이템 value 의 천분율, 0 이면 사지 않음).
    shops: {
        // 마을 잡화점 — 상인 NPC(액터 11)가 연다.
        1: (
            goods: [
                (item: 501, price: 50),
                (item: 502, price: 60),
                (item: 2101, price: 250),
                (item: 3002, price: 1000),
            ],
            buy_rate: 500,
        ),
    },

    // 제작 표 (R4-2) — recipes 의 순서가 레시피 번호다. inputs 는 두 가방을 합쳐 센다.
    // fee 는 수수료(기본 재화), count 는 결과물 개수(적지 않으면 1), requires 는 만들 수 있는 조건.
    crafts: {
        1: (
            recipes: [
                (inputs: [(item: 909, count: 5)], fee: 10, output: 501),
                (inputs: [(item: 909, count: 10)], output: 1101, requires: Level(cmp: Ge, value: 3)),
            ],
        ),
    },
    // 텔레포트 목적지 표 (R4-2) — level 을 비우면 지금 존 안, 적으면 그 레벨(levels/<번호>)을 열고 pos 에 선다.
    // price 는 기본 재화. 목적지 이름은 display.ron 의 teleports.
    teleports: {
        1: (destinations: [(pos: (0.0, 0.0), price: 10)]),
        2: (
            destinations: [
                (level: "village", pos: (-6.0, 10.0)),
                (level: "sample", pos: (-6.0, 10.0), price: 30),
            ],
        ),
    },

    // 퀘스트 (R5) — stages 를 차례로 채우고, 마지막 단계를 채우면 담당 NPC(기능 Quest(N))에게 보고한다.
    // 목표: Kill(actor, count — actor 0 = 아무나) · Collect(item, count, take — 보고할 때 가져갈지) ·
    //       Reach(center, radius) · Talk(actor) · Check(조건). then(단계 효과)·rewards·requires 는 트리거와 같은 형식.
    // auto_complete 면 보고 없이 그 자리에서 끝난다(담당 NPC 가 없는 월드 퀘스트 — 트리거 StartQuest 로 시작).
    // 제목·설명은 display.ron 의 quests.
    quests: {
        // 상인 — 마을 근처의 슬라임을 줄여 달라.
        1: (
            stages: [(objectives: [Kill(actor: 100, count: 3)])],
            rewards: [GiveCurrency(currency: 1, amount: 100), GiveExp(80), GiveLoot(1)],
        ),
        // 대장장이 — 상인에게 들러 젤리를 모아 온다. 1 을 끝내야 받는다.
        2: (
            requires: Quest(quest: 1, state: Completed),
            stages: [
                (objectives: [Talk(actor: 11)]),
                (objectives: [Collect(item: 909, count: 5, take: true)]),
            ],
            rewards: [GiveItem(item: 3001, count: 1), GiveCurrency(currency: 1, amount: 50)],
        ),
        // 월드 퀘스트 — 레벨 2 가 되면 트리거 4 가 준다. 광장에 가면 그 자리에서 끝난다.
        3: (
            stages: [(objectives: [Reach(center: (0.0, 0.0), radius: 2.0)])],
            rewards: [GiveCurrency(currency: 1, amount: 20)],
            auto_complete: true,
        ),
    },

    // 경험치 곡선 (R3) — 레벨 level 에서 다음 레벨까지 필요한 경험치. 변수는 level 하나.
    // 적지 않으면 이 식(서버 CharacterEntityData 와 같다).
    exp_curve: "level * level * 100",

    // 직업 (R2) — 새 게임에서 고른다(ui/class_select). 이름·설명은 display.ron.
    // base 는 레벨 1 의 기본 스탯, growth 는 레벨당 더해지는 값 (적지 않은 스탯은 0).
    // skills 는 **시작 스킬** — 새 게임에서 1레벨로 배우고 처음 단축키에 차례로 놓인다 (R3).
    // formulas 를 적으면 그 직업만 그 파생 수식을 쓴다 (stats.derived 와 같은 칸). skills 는 단축키 (맨 앞이 1번 키).
    classes: {
        // 지금까지의 플레이어와 같은 수치 — HP 200(+40), MP 60(+10), 공격 20(+4), 방어 5(+2).
        1: (
            base: {"str": 10, "vit": 9, "int": 5, "agi": 5},
            growth: {"str": 2, "vit": 1, "int": 1, "agi": 2},
            skills: [5, 6, 7, 8],
        ),
        // 마법사 — MP 가 많고 지능으로 MP 가 빨리 찬다. 몸은 약하다.
        2: (
            base: {"str": 5, "vit": 6, "int": 12, "agi": 3},
            growth: {"str": 1, "vit": 1, "int": 3, "agi": 1},
            skills: [8, 6],
            formulas: (max_mp: "int * 12 + 20"),
        ),
        // 궁수 — 민첩이 공격에도 들어간다 (직업 수식).
        3: (
            base: {"str": 6, "vit": 7, "int": 5, "agi": 9},
            growth: {"str": 1, "vit": 1, "int": 1, "agi": 3},
            skills: [6, 5],
            formulas: (attack: "str + agi * 3 / 2 + equip_attack", defense: "agi / 2 + equip_defense"),
        ),
    },

    // 트리거 — 언제(on) · 만약(when, 적지 않으면 늘 참) · 한다(then) (R1).
    // 그 tick 의 일이 다 끝난 뒤 번호 순으로 본다 — 앞 번호가 바꾼 플래그를 뒤 번호가 본다.
    // "한 번만" 은 플래그로 막는다 (조건에 Not(Flag(… 1)), 효과에 SetFlag(… 1)). 플래그는 저장 파일에 남는다.
    // 플래그 번호는 서버와 같은 ID 공간이다. 지금 쓰는 번호:
    //   캐릭터 1 = 슬라임 처치 수, 2 = 슬라임 사냥 보상 받음
    triggers: {
        // 플레이어가 슬라임을 쓰러뜨릴 때마다 센다.
        1: (
            on: Killed(actor: Some(100)),
            when: Actor(1),
            then: [AddFlag(scope: Character, flag: 1, delta: 1)],
        ),
        // 다섯 마리째에 한 번만 보상 — 빨간 포션 3개·강베기 비급·경험치 100.
        2: (
            on: Killed(actor: Some(100)),
            when: All([
                Actor(1),
                Flag(scope: Character, flag: 1, cmp: Ge, value: 5),
                Not(Flag(scope: Character, flag: 2, cmp: Eq, value: 1)),
            ]),
            then: [
                GiveItem(item: 501, count: 3),
                GiveItem(item: 3001, count: 1),
                GiveExp(100),
                SetFlag(scope: Character, flag: 2, value: 1),
            ],
        ),
        // 레벨 3 이 되면 화염구 — 마법사만 배운다 (다른 직업은 스킬의 classes 에 막혀 조용히 지나간다).
        3: (
            on: LevelReached(3),
            when: Actor(1),
            then: [GrantSkill(skill: 9)],
        ),
        // 레벨 2 가 되면 월드 퀘스트 3 (R5).
        4: (
            on: LevelReached(2),
            when: Actor(1),
            then: [StartQuest(3)],
        ),
    },
)
