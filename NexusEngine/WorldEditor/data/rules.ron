// 게임 규칙 수치 — 서버 테이블과 짝을 이루는 절반. 이름·색·에셋 경로는 display.ron 에.
//
// 번호(스킬·아이템·드롭 테이블·진영)는 서버와 같은 ID 공간이다 — ID 공간이 곧 프로토콜.
// 단위: 거리 m, 속도 m/s, 시간 ms, 확률 천분율(1000 = 반드시).
// 이 파일을 고치면 다음 플레이 시작(F5)부터 적용된다 — 다시 빌드할 필요 없다.
(
    version: 1,
    // 드롭 난수 시드. 같은 시드·같은 입력이면 같은 드롭이 나온다.
    seed: 1,

    // 진영 관계 (대칭). 적지 않은 쌍은 중립, 같은 진영은 우호.
    // 1 = 플레이어, 100 = 마을, 201 = 야생 몬스터 (서버 EFactionId 와 같은 번호 공간)
    relations: [
        (a: 1, b: 201, relation: Hostile),
    ],

    // 스킬 — 서버 SkillDef 의 단일 대상 부분.
    skills: {
        1: (range: 2.0, cooldown_ms: 800, damage_mult: 1.0),   // 플레이어 베기
        2: (range: 1.5, cooldown_ms: 1200, damage_mult: 1.0),  // 슬라임 물기
        3: (range: 2.0, cooldown_ms: 1000, damage_mult: 1.2),  // 경비병 일격
    },

    items: {
        501: Consumable(heal: 60, max_stack: 20),   // 빨간 포션
        909: Consumable(heal: 15, max_stack: 99),   // 젤리
        1101: Equipment(slot: Weapon, attack: 12, defense: 0),  // 숏소드
        2101: Equipment(slot: Head, attack: 0, defense: 4),     // 모자
    },

    // 드롭 테이블 — 줄마다 따로 굴린다.
    loot: {
        1: [
            (item: 909, count: 1, chance_per_mille: 800),
            (item: 501, count: 1, chance_per_mille: 250),
            (item: 2101, count: 1, chance_per_mille: 150),
        ],
    },

    // 액터 타입별 수치. 마커가 이 번호를 가리킨다 (이름·스프라이트는 display.ron).
    //
    // 번호는 서버 테이블과 같은 ID 공간이다. 지금 쓰는 구간:
    //   1~9    플레이어블
    //   10~99  NPC
    //   100~   몬스터
    actors: {
        1: (
            move_speed: 4.0,
            max_hp: 200,
            attack: 20,
            defense: 5,
            faction: 1,
            basic_attack: Some(1),
            // 레벨이 오를 때마다 더해지는 수치 (P3). 필요 경험치는 level² × 100.
            growth: (max_hp: 40, attack: 4, defense: 2),
        ),
        // 서버 NpcEntityData 기본값처럼 불사·방어형.
        10: (
            move_speed: 1.5,
            max_hp: 300,
            attack: 25,
            defense: 10,
            immortal: true,
            faction: 100,
            ai: Defensive,
            aggro_range: 6.0,
            leash_range: 10.0,
            basic_attack: Some(3),
        ),
        // 서버 MonsterEntityData 기본값처럼 공격형.
        100: (
            move_speed: 2.0,
            max_hp: 80,
            attack: 18,
            defense: 2,
            faction: 201,
            ai: Aggressive,
            aggro_range: 6.0,
            leash_range: 14.0,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 60,
        ),
        // 같은 몬스터 마커라도 타입이 다르면 수치가 다르다 — 액터 타입의 요점.
        101: (
            move_speed: 2.6,
            max_hp: 140,
            attack: 26,
            defense: 6,
            faction: 201,
            ai: Aggressive,
            aggro_range: 9.0,
            leash_range: 18.0,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 140,
        ),
        // 스크립트로 움직이는 액터 (P2). AI 는 Passive — 누구를 언제 칠지는 스크립트가 정한다.
        // script 는 data/ 기준 경로. 스크립트를 고치고 F5 만 다시 누르면 적용된다.
        102: (
            move_speed: 3.2,
            max_hp: 90,
            attack: 16,
            defense: 3,
            faction: 201,
            basic_attack: Some(2),
            loot: Some(1),
            exp_reward: 90,
            script: Some("scripts/goblin.rhai"),
        ),
        103: (
            move_speed: 2.0,
            max_hp: 50,
            attack: 5,
            defense: 0,
        ),
    },

    // 마커 종류별 기본 액터 — 마커가 타입을 정하지 않았을 때(예전 존 파일 포함) 쓴다.
    default_actors: {
        Player: 1,
        Npc: 10,
        Monster: 100,
    },

    // 플레이어가 클릭으로 공격할 때 쓰는 스킬.
    player_attack: 1,
    // 플레이어 시작 소지품.
    starting_kit: [
        (item: 501, count: 3),
        (item: 1101, count: 1),
    ],
)
