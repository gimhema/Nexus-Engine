// UI 테마 — 폰트와 창 그림, 확대 배율. **클라이언트만 보는 데이터다.**
//
// 위젯 배치는 이 파일이 아니라 화면 파일(`ui/<번호>.ui.ron`)에 있다 — 에디터의
// 위젯 편집기가 그쪽을 고친다. 이 파일에서 편집기가 건드리는 것은 `scale` 줄 하나뿐이라
// 아래 주석은 저장해도 남는다.
//
// ⚠ 이 폰트에는 한글도 '/' 도 없다 — 화면 문구는 영문·숫자만.
(
    version: 1,

    font: (
        image: "assets/third_party/zelda-like-armm1998/gfx/font.png",
        // 글자 하나가 차지하는 가로 폭과 줄 높이 (픽셀).
        advance: 8,
        line_height: 16,
        // 받아온 폰트는 균일 격자가 아니다 — 알파벳은 8×16 칸, 숫자는 8×8 로 오른쪽 구석에 있다.
        // 그래서 칸 크기를 구간마다 따로 적는다. (x, y) 는 첫 글자의 왼쪽 위 픽셀이다.
        runs: [
            (chars: "AaBbCcDdEeFfGgHhIiJjKkLlMm", x: 0, y: 0, size: (8, 16)),
            (chars: "NnOoPpQqRrSsTtUuVvWwXxYyZz", x: 0, y: 16, size: (8, 16)),
            (chars: ".,!¡?¿#_-▼:;'\"", x: 0, y: 32, size: (8, 16)),
            (chars: "012", x: 216, y: 0, size: (8, 8)),
            (chars: "345", x: 216, y: 8, size: (8, 8)),
            (chars: "678", x: 216, y: 16, size: (8, 8)),
            (chars: "9", x: 224, y: 24, size: (8, 8)),
        ],
    ),

    // 창 배경 — 같은 그림 아래쪽에 있는 말풍선 상자를 9-slice 로 쓴다.
    // border 는 늘어나지 않는 가장자리 두께 (픽셀).
    // ⚠ height 는 **그림이 실제로 그려진 72줄**이다 — 88 로 잡으면 아래 16줄(투명)까지
    //   늘어나 창의 아래 테두리가 눌린다 (스크린샷으로 발견).
    panel: (x: 0, y: 48, width: 240, height: 72, border: 12),

    // UI 확대 배율. **정수여야** 픽셀이 뭉개지지 않는다.
    scale: 2,

    // 글자를 시스템 폰트로 그린다 (P7-E) — **이것이 있어야 한글이 나온다.**
    // size 는 UI 픽셀이고, 실제로는 size × scale 픽셀로 구워 1:1 로 그린다.
    // candidates 를 비우면 OS 별 기본 후보(맑은 고딕·나눔고딕·Noto CJK …)를 찾는다.
    // 폰트를 못 찾으면 비트맵 폰트로 그린다 — 그때는 한글이 보이지 않는다.
    text_font: Some((size: 14)),
)
