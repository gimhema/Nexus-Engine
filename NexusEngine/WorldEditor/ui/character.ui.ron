                    ),
                ),
                (
                    id: "equip_title",
                    anchor: TopLeft,
                    pos: (12, 42),
                    kind: Text(
                        format: "장비",
                    ),
                ),
                (
                    id: "equipment",
                    anchor: TopLeft,
                    pos: (12, 56),
                    size: Some((170, 92)),
                    kind: List(
                        row_height: 13,
                        source: Equipment,
                    ),
                ),
                (
                    id: "skills_title",
                    anchor: TopLeft,
                    pos: (12, 152),
                    kind: Text(
                        format: "스킬 — 누르면 단축키에",
                    ),
                ),
                (
                    id: "skills",
                    anchor: TopLeft,
                    pos: (12, 166),
                    size: Some((170, 66)),
                    kind: List(
                        row_height: 13,
                        source: Skills,
                    ),
                ),
                (
                    id: "bag_title",
                    anchor: TopLeft,
                    pos: (194, 42),
                    kind: Text(
                        format: "가방 — 누르면 쓰기 또는 입기",
                    ),
                ),
                (
                    id: "bag",
                    anchor: TopLeft,
                    pos: (194, 56),
                    size: Some((170, 66)),
