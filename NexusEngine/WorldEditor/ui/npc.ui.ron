// 화면(UI) 한 장 — 위젯 트리. **에디터의 위젯 편집기가 이 파일을 다시 써낸다.**
// 메뉴 UI → 위젯 편집기. 저장하면 이 파일이 통째로 다시 쓰이므로 주석은 남지 않는다.
//
// pos·size 는 UI 픽셀(테마의 scale 을 곱하기 전)이고, anchor 기준점에서 오른쪽·아래가 +다.
// 글자 문구에 쓸 수 있는 값: {hp} {max_hp} {mp} {max_mp} {level} {exp} {exp_to_next} {loading}(로딩 %) {revive}(부활까지 초) {class}(직업) {gold}(기본 재화)
// NPC 창(R4b): {npc_name} {npc_profile}(인사말) {npc_page}(지금 쪽) — Paragraph 는 폭에 맞춰 줄을 바꾸고, List 는 NPC 창의 목록 줄이다.
// Image 위젯의 path 는 작업 디렉터리 기준 PNG (소문자·'/'), region 은 그림의 픽셀 사각형이다.
(
    version: 1,
    name: "NPC 창",
    widgets: [
        (
            id: "window",
            anchor: Center,
            pos: (0, -10),
            size: Some((290, 204)),
            kind: Panel(
                frame: true,
            ),
            children: [
                (
                    id: "back_fill",
                    anchor: Center,
                    pos: (0, 0),
                    size: Some((280, 194)),
                    kind: Fill(
                        color: (0.07, 0.08, 0.11, 1.0),
                    ),
                ),
                (
                    id: "npc_name",
                    anchor: TopLeft,
                    pos: (12, 10),
                    kind: Text(
                        format: "{npc_name}",
                    ),
                ),
                (
                    id: "greeting",
                    anchor: TopLeft,
                    pos: (12, 28),
                    size: Some((266, 30)),
                    kind: Paragraph(
                        format: "{npc_profile}",
                    ),
                ),
                (
                    id: "page",
                    anchor: TopLeft,
                    pos: (12, 62),
                    kind: Text(
                        format: "— {npc_page}",
                    ),
                ),
                (
                    id: "rows",
                    anchor: TopLeft,
                    pos: (12, 78),
                    size: Some((266, 90)),
                    kind: List(
                        row_height: 15,
                    ),
                ),
                (
                    id: "purse",
                    anchor: BottomLeft,
                    pos: (12, -10),
                    kind: Text(
                        format: "소지금 {gold}",
                    ),
                ),
                (
                    id: "back",
                    anchor: BottomRight,
                    pos: (-58, -8),
                    kind: Button(
                        label: "뒤로",
                        action: NpcBack,
                    ),
                ),
                (
                    id: "close",
                    anchor: BottomRight,
                    pos: (-10, -8),
                    kind: Button(
                        label: "닫기",
                        action: Close,
                    ),
                ),
            ],
        ),
    ],
)
