// 화면(UI) 한 장 — 위젯 트리. **에디터의 위젯 편집기가 이 파일을 다시 써낸다.**
// 메뉴 UI → 위젯 편집기. 저장하면 이 파일이 통째로 다시 쓰이므로 주석은 남지 않는다.
//
// pos·size 는 UI 픽셀(테마의 scale 을 곱하기 전)이고, anchor 기준점에서 오른쪽·아래가 +다.
// 글자 문구에 쓸 수 있는 값: {hp} {max_hp} {mp} {max_mp} {level} {exp} {exp_to_next} {loading}(로딩 %) {revive}(부활까지 초) {class}(직업) {gold}(기본 재화) {attack} {defense}
// NPC 창(R4b): {npc_name} {npc_profile}(인사말) {npc_page}(지금 쪽) — Paragraph 는 폭에 맞춰 줄을 바꾸고, List 는 NPC 창의 목록 줄이다.
// Image 위젯의 path 는 작업 디렉터리 기준 PNG (소문자·'/'), region 은 그림의 픽셀 사각형이다.
(
    version: 1,
    name: "직업 고르기",
    widgets: [
        (
            id: "window",
            anchor: Center,
            pos: (0, 0),
            size: Some((320, 196)),
            kind: Panel(
                frame: true,
            ),
            children: [
                (
                    id: "shade",
                    anchor: Center,
                    pos: (0, 0),
                    size: Some((300, 176)),
                    kind: Fill(
                        color: (0.08, 0.07, 0.1, 0.85),
                    ),
                ),
                (
                    id: "title",
                    anchor: Top,
                    pos: (0, 12),
                    kind: Text(
                        format: "직업 고르기",
                    ),
                ),
                (
                    id: "intro",
                    anchor: Top,
                    pos: (0, 30),
                    size: Some((280, 30)),
                    kind: Paragraph(
                        format: "이 세계 사람들은 머리 대신 사물을 얹고 산다. 직업을 고르면 다음 화면에서 머리 사물을 고른다.",
                    ),
                ),
                (
                    id: "warrior",
                    anchor: TopLeft,
                    pos: (20, 72),
                    size: Some((70, 22)),
                    kind: Button(
                        label: "전사",
                        action: Customize(
                            class: 1,
                            level: "village",
                        ),
                    ),
                ),
                (
                    id: "warrior_note",
                    anchor: TopLeft,
                    pos: (100, 76),
                    kind: Text(
                        format: "단단한 몸 · 가까이서 벤다",
                    ),
                ),
                (
                    id: "mage",
                    anchor: TopLeft,
                    pos: (20, 100),
                    size: Some((70, 22)),
                    kind: Button(
                        label: "마법사",
                        action: Customize(
                            class: 2,
                            level: "village",
                        ),
                    ),
                ),
                (
                    id: "mage_note",
                    anchor: TopLeft,
                    pos: (100, 104),
                    kind: Text(
                        format: "마나로 멀리서 마법을 쏜다",
                    ),
                ),
                (
                    id: "archer",
                    anchor: TopLeft,
                    pos: (20, 128),
                    size: Some((70, 22)),
                    kind: Button(
                        label: "궁수",
                        action: Customize(
                            class: 3,
                            level: "village",
                        ),
                    ),
                ),
                (
                    id: "archer_note",
                    anchor: TopLeft,
                    pos: (100, 132),
                    kind: Text(
                        format: "발판 위에서 활로 노린다",
                    ),
                ),
                (
                    id: "back",
                    anchor: Bottom,
                    pos: (0, -12),
                    size: Some((64, 20)),
                    kind: Button(
                        label: "뒤로",
                        action: Close,
                    ),
                ),
            ],
        ),
    ],
)
